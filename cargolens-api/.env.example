# CargoLens AI — Application Configuration Example
# Copy to .env and adjust values for local development

PROJECT_NAME="CargoLens AI API"
ENVIRONMENT="development"
DEBUG=true

# Server
HOST=127.0.0.1
PORT=8000

# CORS (JSON string array or comma-separated list of permitted origins)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Security & Authentication Configuration
# Replace these placeholders with secure random values in your local .env
JWT_SECRET_KEY=replace-with-a-long-random-jwt-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
BOOTSTRAP_SECRET=replace-with-a-long-random-bootstrap-secret

# ==============================================================================
# PostgreSQL Application Database Configuration
# ==============================================================================
POSTGRES_SERVER=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=cargolens_user
POSTGRES_PASSWORD=replace-with-your-local-database-password
POSTGRES_DB=cargolens_db

# Optional direct connection string override for application runtime
# DATABASE_URL=postgresql+asyncpg://cargolens_user:replace-with-your-local-database-password@127.0.0.1:5432/cargolens_db

# ==============================================================================
# Isolated Automated Test Database Configuration
# ==============================================================================
# Automated tests must use the isolated test database, never cargolens_db.

CARGOLENS_TEST_DATABASE_URL=postgresql+asyncpg://cargolens_user:replace-with-your-local-database-password@127.0.0.1:5432/cargolens_test_db

# Optional: Dedicated Alembic test migration database URL
CARGOLENS_ALEMBIC_DATABASE_URL=postgresql://cargolens_user:replace-with-your-local-database-password@127.0.0.1:5432/cargolens_test_db

# AI Provider Configuration (Claude Vision / Anthropic)
# Required for real AI extraction in production; leave blank in local dev or unit tests.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_TIMEOUT_SECONDS=60.0
ANTHROPIC_MAX_RETRIES=2